<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiIBGE.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiIBGE"
    xmlns:views="clr-namespace:MauiIBGE.Views"
    Shell.TabBarIsVisible="True"
    Shell.BackgroundColor="White"
    Shell.ForegroundColor="#1565C0"
    Shell.TitleColor="#1565C0"
    Shell.TabBarBackgroundColor="White"
    Shell.TabBarForegroundColor="#1565C0"
    Shell.TabBarTitleColor="#1565C0"
    Shell.TabBarUnselectedColor="#606060"
    Title="MauiIBGE">

    <TabBar>
        <Tab Title="IBGE &amp; Clima">
            <ShellContent
                Title="IBGE e Clima"
                ContentTemplate="{DataTemplate local:MainPage}"
                Route="MainPage" />
        </Tab>

        <Tab Title="ViaCEP">
            <ShellContent
                Title="Consulta ViaCEP"
                ContentTemplate="{DataTemplate views:ViaCepPage}"
                Route="ViaCepPage" />
        </Tab>

        <Tab Title="Nutrição USDA">
            <ShellContent
                Title="USDA FoodData Central"
                ContentTemplate="{DataTemplate views:NutricaoPage}"
                Route="NutricaoPage" />
        </Tab>
    </TabBar>

</Shell>
