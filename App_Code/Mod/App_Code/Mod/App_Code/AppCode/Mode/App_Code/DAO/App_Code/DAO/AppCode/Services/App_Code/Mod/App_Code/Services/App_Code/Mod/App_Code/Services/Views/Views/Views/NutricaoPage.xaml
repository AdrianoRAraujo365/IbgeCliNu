<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mod="clr-namespace:MauiIBGE.App_Code.Mod"
             x:Class="MauiIBGE.Views.NutricaoPage"
             Title="Nutrição USDA">
    <Grid RowDefinitions="Auto, Auto, Auto, *" Padding="16" RowSpacing="12">
        <Label Grid.Row="0"
               Text="USDA FoodData Central"
               FontSize="24"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <SearchBar Grid.Row="1"
                   x:Name="AlimentoSearchBar"
                   Placeholder="Buscar alimento (ex: apple, cheddar, banana)..."
                   SearchButtonPressed="AlimentoSearchBar_SearchButtonPressed" />

        <ActivityIndicator Grid.Row="2"
                           x:Name="LoadingIndicator"
                           IsVisible="False"
                           IsRunning="False"
                           Color="#10B981"
                           HorizontalOptions="Center" />

        <CollectionView Grid.Row="3" x:Name="AlimentosCollectionView">
            <CollectionView.EmptyView>
                <Label Text="Pesquise um alimento para visualizar os nutrientes (base 100g)."
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HorizontalTextAlignment="Center" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="mod:FoodItem">
                    <Border Stroke="#E5E7EB" StrokeThickness="1" StrokeShape="RoundRectangle 10" Padding="14" Margin="0,0,0,10">
                        <VerticalStackLayout Spacing="6">
                            <Label Text="{Binding Description}" FontSize="16" FontAttributes="Bold" />
                            <Label Text="{Binding FdcId, StringFormat='FDC ID: {0}'}" FontSize="12" TextColor="Gray" />
                            <BoxView HeightRequest="1" Color="#E5E7EB" />

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding FoodNutrients}" Spacing="4">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="mod:NutrientDetail">
                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Grid.Column="0" Text="{Binding NutrientName}" FontSize="13" TextColor="#374151" />
                                            <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                                <Label Text="{Binding Value, StringFormat='{0:F1}'}" FontSize="13" FontAttributes="Bold" />
                                                <Label Text="{Binding UnitName}" FontSize="13" TextColor="Gray" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
