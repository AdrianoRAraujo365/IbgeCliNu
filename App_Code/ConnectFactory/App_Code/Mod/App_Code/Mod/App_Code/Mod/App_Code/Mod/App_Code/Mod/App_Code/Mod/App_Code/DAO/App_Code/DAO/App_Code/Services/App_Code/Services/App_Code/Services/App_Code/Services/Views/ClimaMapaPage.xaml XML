<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mod="clr-namespace:MauiIBGE.App_Code.Mod"
             x:Class="MauiIBGE.Views.ClimaMapaPage"
             Title="Painel Regional">

    <ScrollView>
        <VerticalStackLayout Padding="18" Spacing="14">

            <!-- Cabeçalho da Localidade e Região -->
            <Border StrokeShape="RoundRectangle 12" Padding="14" BackgroundColor="#EFF6FF">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="LocalidadeHeaderLabel"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#1E3A8A"
                           HorizontalOptions="Center"
                           HorizontalTextAlignment="Center" />
                    <Label x:Name="RegiaoHeaderLabel"
                           FontSize="15"
                           FontAttributes="Bold"
                           TextColor="#0284C7"
                           HorizontalOptions="Center" />
                    <Label x:Name="LogradouroHeaderLabel"
                           FontSize="13"
                           TextColor="DimGray"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Barra de Abas Internas -->
            <Grid ColumnDefinitions="*, *, *" ColumnSpacing="6">
                <Button x:Name="TabClimaBtn"
                        Grid.Column="0"
                        Text="Clima &amp; Calor"
                        FontSize="12"
                        BackgroundColor="#1565C0"
                        TextColor="White"
                        Clicked="TabClimaBtn_Clicked" />
                <Button x:Name="TabAgroBtn"
                        Grid.Column="1"
                        Text="Agronegócio"
                        FontSize="12"
                        BackgroundColor="#E2E8F0"
                        TextColor="#1E293B"
                        Clicked="TabAgroBtn_Clicked" />
                <Button x:Name="TabNutriBtn"
                        Grid.Column="2"
                        Text="Nutrição USDA"
                        FontSize="12"
                        BackgroundColor="#E2E8F0"
                        TextColor="#1E293B"
                        Clicked="TabNutriBtn_Clicked" />
            </Grid>

            <!-- ABA 1: TEMPERATURA, UMIDADE, PRESSÃO E MAPA DE CALOR -->
            <VerticalStackLayout x:Name="AbaClimaLayout" IsVisible="True" Spacing="12">
                <Grid ColumnDefinitions="*, *, *" ColumnSpacing="8">
                    <Border Grid.Column="0" Padding="10" StrokeShape="RoundRectangle 10" BackgroundColor="#F0F9FF">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Média" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label x:Name="MediaLabel" FontSize="18" FontAttributes="Bold" TextColor="#0284C7" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="10" StrokeShape="RoundRectangle 10" BackgroundColor="#FEF2F2">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Máxima" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label x:Name="MaximaLabel" FontSize="18" FontAttributes="Bold" TextColor="#DC2626" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="2" Padding="10" StrokeShape="RoundRectangle 10" BackgroundColor="#EFF6FF">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Mínima" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label x:Name="MinimaLabel" FontSize="18" FontAttributes="Bold" TextColor="#2563EB" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="*, *" ColumnSpacing="8">
                    <Border Grid.Column="0" Padding="10" StrokeShape="RoundRectangle 10" BackgroundColor="#ECFDF5">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Umidade Relativa" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label x:Name="UmidadeLabel" FontSize="18" FontAttributes="Bold" TextColor="#059669" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                    <Border Grid.Column="1" Padding="10" StrokeShape="RoundRectangle 10" BackgroundColor="#F5F3FF">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Pressão Atmosférica" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                            <Label x:Name="PressaoLabel" FontSize="18" FontAttributes="Bold" TextColor="#7C3AED" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Label Text="Mapa de Calor Regional e Previsão de 5 Dias"
                       FontSize="14"
                       FontAttributes="Bold"
                       HorizontalOptions="Center" />

                <Border StrokeShape="RoundRectangle 12" HeightRequest="430" Padding="4">
                    <WebView x:Name="MapaCalorWebView" />
                </Border>
            </VerticalStackLayout>

            <!-- ABA 2: TIPO DE AGRONEGÓCIO DA CIDADE / ESTADO / REGIÃO -->
            <VerticalStackLayout x:Name="AbaAgroLayout" IsVisible="False" Spacing="12">
                <Border StrokeShape="RoundRectangle 12" Padding="16" BackgroundColor="#F0FDF4" Stroke="#BBF7D0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Vocação Agropecuária Local" FontSize="18" FontAttributes="Bold" TextColor="#166534" />
                        <Label x:Name="RegiaoAgroLabel" FontSize="14" FontAttributes="Bold" TextColor="#15803D" />

                        <BoxView HeightRequest="1" Color="#DCFCE7" />

                        <Label Text="Tipo de Agronegócio Predominante:" FontSize="13" TextColor="Gray" />
                        <Label x:Name="TipoAgroLabel" FontSize="16" FontAttributes="Bold" TextColor="#14532D" />

                        <Label Text="Principais Culturas e Cadeias Produtivas:" FontSize="13" TextColor="Gray" />
                        <Label x:Name="CulturasAgroLabel" FontSize="15" TextColor="#1F2937" />

                        <Label Text="Faixa Térmica Agrícola Hoje:" FontSize="13" TextColor="Gray" />
                        <Label x:Name="ClimaAgroResumoLabel" FontSize="14" FontAttributes="Bold" TextColor="#0369A1" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ABA 3: PRODUTO NUTRICIONAL MAIS VENDIDO (USDA FOODDATA CENTRAL) -->
            <VerticalStackLayout x:Name="AbaNutriLayout" IsVisible="False" Spacing="12">
                <Border StrokeShape="RoundRectangle 12" Padding="14" BackgroundColor="#FFFBEB" Stroke="#FDE68A">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Produto Nutricional Mais Vendido / Destaque Local"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#92400E" />
                        <Label x:Name="ProdutoDestaqueLabel"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#B45309" />
                        <Label Text="Tabela nutricional oficial obtida via USDA FoodData Central (por 100g):"
                               FontSize="12"
                               TextColor="DimGray" />
                    </VerticalStackLayout>
                </Border>

                <ActivityIndicator x:Name="NutriLoadingIndicator" IsRunning="False" IsVisible="False" HorizontalOptions="Center" />

                <VerticalStackLayout x:Name="ListaNutrientesUsdaLayout" Spacing="10" />

                <Button Text="Pesquisar Outros Alimentos na Tela USDA"
                        BackgroundColor="#10B981"
                        TextColor="White"
                        CornerRadius="8"
                        Clicked="AbrirTelaNutricao_Clicked" />
            </VerticalStackLayout>

            <Button Text="Voltar ao Formulário"
                    BackgroundColor="#475569"
                    TextColor="White"
                    CornerRadius="10"
                    Clicked="VoltarButton_Clicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
